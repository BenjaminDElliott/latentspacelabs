{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/BenjaminDElliott/latentspacelabs/icp/run-report.schema.json",
  "title": "Research Agent I/O Contract",
  "description": "I/O contract for research agent type. Validates RunReport envelope (ADR-0006).",
  "type": "object",
  "definitions": {
    "RunReport": {
      "type": "object",
      "required": [
        "schema_version",
        "run_id",
        "agent_type",
        "status",
        "triggered_by",
        "linear_issue_id",
        "autonomy_level",
        "started_at",
        "ended_at",
        "summary",
        "decisions",
        "next_actions",
        "errors",
        "cost"
      ],
      "properties": {
        "schema_version": {
          "type": "string",
          "pattern": "^\\d+\\.\\d+\\.\\d+$",
          "description": "Envelope schema version (SemVer)."
        },
        "run_id": {
          "type": "string",
          "minLength": 1
        },
        "agent_type": {
          "type": "string",
          "enum": ["coding", "qa", "review", "sre", "pm", "research", "observability"]
        },
        "status": {
          "type": "string",
          "enum": ["started", "succeeded", "failed", "cancelled", "needs_human"]
        },
        "triggered_by": {
          "type": "string",
          "enum": ["user", "linear_status", "schedule", "webhook", "agent", "github_comment", "hook", "mcp"]
        },
        "linear_issue_id": {
          "type": "string"
        },
        "autonomy_level": {
          "type": "string",
          "enum": ["L1-read-only", "L2-propose", "L3-with-approval", "L4-autonomous"]
        },
        "started_at": {
          "type": "string",
          "format": "date-time"
        },
        "ended_at": {
          "type": "string",
          "format": "date-time"
        },
        "summary": {
          "type": "string"
        },
        "decisions": {
          "type": "array",
          "items": { "type": "string" },
          "minItems": 0
        },
        "next_actions": {
          "type": "array",
          "items": { "type": "string" },
          "minItems": 0
        },
        "errors": {
          "type": "array",
          "items": { "type": "string" },
          "minItems": 0
        },
        "cost": {
          "type": "object",
          "required": ["band", "budget_cap_usd", "spent_usd", "band_unavailable_reason"],
          "properties": {
            "band": {
              "type": "string",
              "enum": ["normal", "elevated", "runaway_risk", "unknown"]
            },
            "budget_cap_usd": {
              "type": ["number", "null"],
              "minimum": 0
            },
            "spent_usd": {
              "type": ["number", "null"],
              "minimum": 0
            },
            "band_unavailable_reason": {
              "type": ["string", "null"]
            }
          },
          "additionalProperties": false
        },
        "correlation": {
          "type": "object",
          "required": ["pr_url", "pr_branch", "commit_sha", "linear_comment_url"],
          "properties": {
            "pr_url": { "type": ["string", "null"] },
            "pr_branch": { "type": ["string", "null"] },
            "commit_sha": { "type": ["string", "null"] },
            "linear_comment_url": { "type": ["string", "null"] }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    }
  },
  "$ref": "#/definitions/RunReport"
}
