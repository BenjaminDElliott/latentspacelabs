{
  "name": "@latentspacelabs/opencode-harness",
  "version": "0.0.0",
  "private": true,
  "description": "LAT-105 opencode + Qwen dry-run ticket-pack harness. Validates a ticket pack against the LAT-104 contract and produces a Linear-ready run summary without invoking opencode, the local Qwen endpoint, GitHub, or Linear. See docs/decisions/0019 and docs/templates/opencode-ticket-pack.md.",
  "license": "UNLICENSED",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "bin": {
    "opencode-dry-run": "./dist/cli.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "clean": "rm -rf dist",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test src/*.test.ts",
    "coverage": "tsx --experimental-test-coverage --test src/*.test.ts",
    "dry-run": "tsx src/cli.ts"
  },
  "devDependencies": {
    "@types/node": "^20.12.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}
