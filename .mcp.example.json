{
  "//": "Template for `.mcp.json`. Placeholders only — never commit a real token.",
  "//docs": "See docs/process/secret-commit-guardrails.md and .env.example (AUTH_TOKEN).",
  "//override": "For a local override, copy this file to `.mcp.local.json` (git-ignored) and edit there.",
  "mcpServers": {
    "agent_handler": {
      "command": "npx",
      "args": [
        "-y",
        "mcp-remote@latest",
        "https://agent-proxy.perplexity.ai/merge_mcp",
        "--header",
        "Authorization: Bearer ${AUTH_TOKEN}"
      ],
      "env": {
        "AUTH_TOKEN": "${AUTH_TOKEN}"
      }
    }
  }
}
